    {
      "parameters": {
        "jsCode": "const raw = $input.first().json['Paste URLs (one per line)'] || '';\nconst urls = String(raw)\n  .split(/[\\n,]+/)\n  .map((u) => u.trim())\n  .filter((u) => /^https?:\\/\\//i.test(u));\nreturn urls.map((url) => ({ json: { url } }));"
